{
  "name": "prophet-mini",
  "d_model": 1280,
  "n_layers": 16,
  "norm_eps": 1e-05,
  "norm_kind": "rmsnorm",
  "residual_scaling": true,
  "logit_soft_cap": null,
  "z_loss_weight": 0.0001,
  "max_seq_len": 4096,
  "dropout": 0.0,
  "frontend": {
    "mode": "bpe",
    "vocab_size": 32768,
    "tie_word_embeddings": true,
    "byte_vocab_size": 260,
    "local_encoder_layers": 2,
    "local_decoder_layers": 3,
    "local_dim": 512,
    "local_heads": 8,
    "hash_ngram_sizes": [
      3,
      4,
      5,
      6
    ],
    "hash_ngram_buckets": 32768
  },
  "mixer": {
    "pattern": [
      "swa",
      "full_attn"
    ],
    "n_heads": 10,
    "n_kv_heads": 2,
    "head_dim": 128,
    "qk_norm": true,
    "sliding_window": 2048,
    "attention_sink_tokens": 1,
    "kv_compression": "none",
    "kv_lora_rank": 512,
    "linear_heads": 10,
    "linear_head_dim": 128,
    "linear_expand": 2.0,
    "conv_kernel": 4,
    "linear_beta_max": 2.0,
    "linear_chunk_size": 64,
    "rope_theta": 500000.0,
    "rope_scaling": "none",
    "rope_scaling_factor": 1.0,
    "nope_layers": [
      1
    ]
  },
  "recurrent": {
    "enabled": true,
    "prelude_layers": 3,
    "core_layers": 4,
    "coda_layers": 3,
    "train_loop_min": 1,
    "train_loop_max": 4,
    "train_loop_dist": "log_uniform",
    "train_loop_poisson_lambda": 4.0,
    "default_loop_k": 2,
    "core_pattern": [
      "gdn"
    ],
    "prelude_pattern": null,
    "coda_pattern": null,
    "inject_input_each_step": true,
    "state_init": "randn",
    "eval_state_init": "zeros",
    "truncated_backprop_steps": 3,
    "halting": "ponder",
    "halting_loss_weight": 0.05,
    "halting_target_steps": 2.0,
    "token_depth": false,
    "ingest_depth": 1,
    "token_depth_random_spans": 0.25
  },
  "ffn": {
    "kind": "dense",
    "activation": "swiglu",
    "hidden_mult": 4.0,
    "n_experts": 64,
    "n_experts_per_token": 6,
    "n_shared_experts": 2,
    "expert_hidden_mult": 0.5,
    "moe_layer_stride": 1,
    "moe_first_dense_layers": 1,
    "router_bias_balancing": true,
    "router_bias_update_rate": 0.001,
    "router_z_loss_weight": 0.001,
    "load_balance_loss_weight": 0.0,
    "router_dtype": "float32"
  },
  "memory": {
    "enabled": false,
    "kind": "none",
    "mount": "output",
    "layers": [],
    "memory_dim": 512,
    "n_slots": 4096,
    "update_rule": "delta",
    "write_lr": 1.0,
    "decay": 1.0,
    "surprise_threshold": 1.0,
    "max_writes": 1000000
  },
  "heads": {
    "n_multi_token_predict": 1,
    "mtp_loss_weight": 0.3,
    "confidence_head": true,
    "confidence_loss_weight": 0.1,
    "action_head": false,
    "action_dk": 128,
    "action_kv_head": 0,
    "sel_loss_weight": 0.5,
    "ptr_loss_weight": 0.5,
    "gate_loss_weight": 0.1,
    "jumped_token_lm_weight": 0.1
  },
  "modality": {
    "n_modalities": 1,
    "modality_embeddings": true,
    "position_dims": 1
  },
  "init_std": 0.02,
  "mup_base_width": null
}