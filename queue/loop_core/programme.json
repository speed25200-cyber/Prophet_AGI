{
  "name": "loop-core-programme",
  "env": {"TRITON_F32_DEFAULT": "tf32x3", "CUBLAS_WORKSPACE_CONFIG": ":4096:8", "OMP_NUM_THREADS": "2"},
  "evidence": {
    "roots": ["outputs/loop-core"],
    "include": ["*.json", "*.jsonl", "*.log", "*.txt", "*.xml"],
    "exclude": ["*.pt", "*.pth", "*.safetensors", "*.bin", "*.npy", "*.npz", "*.zip", "*.tmp"],
    "max_file_bytes": 50000000
  },
  "commands": [
    {"id": "gpu-gate", "timeout_s": 900,
     "argv": ["python", "-m", "pytest", "tests/test_gpu.py", "-q", "--tb=short",
              "--junitxml=outputs/loop-core/gates/test_gpu.xml"]},
    {"id": "benchmark-cache", "timeout_s": 3600,
     "argv": ["python", "scripts/audit_pilot_overlap.py",
              "--sources", "docs/experiments/2026-09-19-benchmark-sources.json",
              "--corpus", "${PROPHET_PILOT}",
              "--cache", "${PROPHET_PERSISTENT}/data/benchmark-audit-v1",
              "--out", "outputs/loop-core/benchmark-audit/pilot-overlap.json"]},
    {"id": "corpus-build", "timeout_s": 14400,
     "argv": ["python", "scripts/prepare_loop_core_corpus.py",
              "--out", "data/loop-core-v1",
              "--prior", "${PROPHET_PILOT}",
              "--benchmark-cache", "${PROPHET_PERSISTENT}/data/benchmark-audit-v1",
              "--tokenizer", "${PROPHET_PILOT}/tokenizer.json"]},
    {"id": "corpus-publish", "timeout_s": 3600,
     "argv": ["python", "scripts/stage_corpus.py", "--source", "data/loop-core-v1",
              "--dest", "${PROPHET_PERSISTENT}/data/loop-core-v1"]},
    {"id": "corpus-manifest-copy", "timeout_s": 60,
     "argv": ["python", "-c", "import shutil, pathlib; d = pathlib.Path('outputs/loop-core/corpus'); d.mkdir(parents=True, exist_ok=True); shutil.copyfile('data/loop-core-v1/manifest.json', d / 'manifest.json'); print('copied')"]},
    {"id": "stage-corpus", "timeout_s": 3600,
     "argv": ["python", "scripts/stage_corpus.py",
              "--source", "${PROPHET_PERSISTENT}/data/loop-core-v1", "--dest", "data/loop-core-v1"]},
    {"id": "preflight-lc_attn", "timeout_s": 1800,
     "argv": ["python", "scripts/run_loop_core.py", "--preflight", "--arm", "lc_attn", "--seed", "0",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/preflight/lc_attn", "--skip-shard-hashes"]},
    {"id": "preflight-lc_gdn", "timeout_s": 1800,
     "argv": ["python", "scripts/run_loop_core.py", "--preflight", "--arm", "lc_gdn", "--seed", "0",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/preflight/lc_gdn", "--skip-shard-hashes"]},
    {"id": "preflight-lc_plain", "timeout_s": 1800,
     "argv": ["python", "scripts/run_loop_core.py", "--preflight", "--arm", "lc_plain", "--seed", "0",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/preflight/lc_plain", "--skip-shard-hashes"]},

    {"id": "train-lc_gdn-seed0", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_gdn", "--seed", "0",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_gdn-seed0", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1700", "--session-minutes", "60"]},
    {"id": "measure-lc_gdn-seed0", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_gdn-seed0",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_gdn-seed0.json"]},
    {"id": "train-lc_attn-seed0", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_attn", "--seed", "0",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_attn-seed0", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1700", "--session-minutes", "60"]},
    {"id": "measure-lc_attn-seed0", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_attn-seed0",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_attn-seed0.json"]},

    {"id": "train-lc_gdn-seed1", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_gdn", "--seed", "1",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_gdn-seed1", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1700", "--session-minutes", "60"]},
    {"id": "measure-lc_gdn-seed1", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_gdn-seed1",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_gdn-seed1.json"]},
    {"id": "train-lc_attn-seed1", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_attn", "--seed", "1",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_attn-seed1", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1700", "--session-minutes", "60"]},
    {"id": "measure-lc_attn-seed1", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_attn-seed1",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_attn-seed1.json"]},

    {"id": "train-lc_gdn-seed2", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_gdn", "--seed", "2",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_gdn-seed2", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1700", "--session-minutes", "60"]},
    {"id": "measure-lc_gdn-seed2", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_gdn-seed2",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_gdn-seed2.json"]},
    {"id": "train-lc_attn-seed2", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_attn", "--seed", "2",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_attn-seed2", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1700", "--session-minutes", "60"]},
    {"id": "measure-lc_attn-seed2", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_attn-seed2",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_attn-seed2.json"]},

    {"id": "train-lc_plain-seed0", "timeout_s": 4200, "repeat_until": "RUN_COMPLETE", "max_attempts": 40,
     "argv": ["python", "scripts/run_loop_core.py", "--arm", "lc_plain", "--seed", "0",
              "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/runs/lc_plain-seed0", "--persistent", "${PROPHET_PERSISTENT}/runs",
              "--max-session-steps", "1600", "--session-minutes", "60"]},
    {"id": "measure-lc_plain-seed0", "timeout_s": 7200,
     "argv": ["python", "scripts/eval_loop_core.py", "--run", "outputs/loop-core/runs/lc_plain-seed0",
              "--step", "18310", "--corpus", "data/loop-core-v1", "--tokenizer", "${PROPHET_PILOT}/tokenizer.json",
              "--out", "outputs/loop-core/measurements/lc_plain-seed0.json"]}
  ]
}
